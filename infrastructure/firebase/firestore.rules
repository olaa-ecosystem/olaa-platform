rules_version = '2';

// Firestore rules for the shared Firebase project `olaa-ecosystem` (ADR-0004).
// Each app owns one top-level area and may only touch the signed-in user's own document.
// Anything not matched below is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // 01 Olaa Language: learner progress, one document per user.
    // Shape: { stateJson: string, updatedAt: int (ms), schemaVersion: int }
    match /language/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['stateJson', 'updatedAt', 'schemaVersion'])
        && request.resource.data.stateJson is string
        && request.resource.data.stateJson.size() < 900000
        && request.resource.data.updatedAt is int
        && request.resource.data.schemaVersion is int;
    }

    // 02 Olaa Habits: habits, check-ins, freezes and badges, one document per user.
    // Same shape as Language: { stateJson: string, updatedAt: int (ms), schemaVersion: int }
    match /habits/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['stateJson', 'updatedAt', 'schemaVersion'])
        && request.resource.data.stateJson is string
        && request.resource.data.stateJson.size() < 900000
        && request.resource.data.updatedAt is int
        && request.resource.data.schemaVersion is int;
    }

    // Cross-app events (contracts/events/language-events.md). Immutable: create only.
    // Each user reads only their own events; the id must start with the writer's uid.
    match /events/{eventId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && eventId.matches(request.auth.uid + '_.+')
        && request.resource.data.keys().hasOnly(['type', 'userId', 'date', 'occurredAt', 'source', 'payload'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.source == 'language'
        && request.resource.data.type in ['language.daily_goal.completed', 'language.lesson.completed']
        && request.resource.data.date is string
        && request.resource.data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.occurredAt is int
        && request.resource.data.payload is map
        && request.resource.data.payload.size() <= 5;
    }
  }
}
